{
    "name": "EldritchCodex/Nodens",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "remoteUser": "eldritchcodex",
    "postCreateCommand": "cmake -S . -B build -G Ninja -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "customizations": {
        "zed": {
            "extensions": ["slang"]
        }
    }
}
